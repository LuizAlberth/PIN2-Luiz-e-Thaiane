# Copy to .env.production on the VM and replace every blank value.
# SITE_DOMAIN: your free DuckDNS name, e.g. mancha-getulio.duckdns.org
SITE_DOMAIN=
ADMIN_EMAIL=
ADMIN_PASSWORD=
APP_SECRET=
PDC_SUPABASE_ANON_KEY=
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
# Opcional: Google Maps Embed API. Deixe vazio para usar o link externo.
VITE_GOOGLE_MAPS_EMBED_API_KEY=
